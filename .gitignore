# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/
*.venv/
venv/

# Mining artifacts -- these hold verbatim source snippets pulled from
# third-party repos (mozilla/bigquery-etl is MPL-2.0). Keep the harness
# code public; keep the mined/labeled data and full repo clones private.
# See README.md "Corpus & licensing" for why.
mining/repos/
mining/output/*.jsonl
mining/output/*.txt
mining/output/chunks/

# Third-party benchmark data (fetched, not redistributed)
eval/benchmarks/*.json

# Generated paper artifacts (build via docs/build_paper.py)
docs/*.pdf
docs/paper1_draft.html
